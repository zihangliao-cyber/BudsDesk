<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BudsDesk · 渝水龙" Width="1040" Height="800" MinWidth="900" MinHeight="710" WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Microsoft YaHei UI" Foreground="#192130">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#7461E8"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#454B5D"/><Setter Property="Background" Value="#F1F2F7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="24"/></Style>
 </Window.Resources>
 <Grid Margin="26,22">
  <Grid.ColumnDefinitions><ColumnDefinition Width="158"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,6,0,36"><Border Background="#7461E8" CornerRadius="11" Width="34" Height="34"><TextBlock Text="渝" Foreground="White" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="BudsDesk" FontWeight="SemiBold" FontSize="19" Margin="10,4,0,0"/></StackPanel>
   <Border Background="#E9E5FC" CornerRadius="12" Padding="16,14"><TextBlock Text="◉   我的耳机" Foreground="#6754D3" FontWeight="SemiBold"/></Border>
   <TextBlock Text="声音，随心掌控。" Foreground="#9095A5" FontSize="12" Margin="15,24,0,0"/>
   <Border Height="1" Background="#E1E4EC" Margin="14,26,14,22"/>
   <TextBlock Text="快捷控制" FontSize="11" Foreground="#999DAA" Margin="15,0,0,14"/>
   <TextBlock Text="Ctrl + Alt + N" FontSize="12" Margin="15,0,0,5"/><TextBlock Text="循环切换监听模式" FontSize="11" Foreground="#9297A6" Margin="15,0,0,18"/>
   <TextBlock Text="Ctrl + Alt + T" FontSize="12" Margin="15,0,0,5"/><TextBlock Text="切换至通透模式" FontSize="11" Foreground="#9297A6" Margin="15,0,0,24"/>
   <Button x:Name="BluetoothSettings" Content="系统蓝牙设置" Background="Transparent" FontSize="12" HorizontalAlignment="Left"/>
   <Button x:Name="Diagnostics" Content="导出诊断日志" Background="Transparent" FontSize="12" HorizontalAlignment="Left"/>
   <TextBlock Text="0.1 · PREVIEW" Foreground="#A0A5B2" FontSize="10" Margin="15,28,0,6"/>
   <TextBlock Text="渝水龙出品" Foreground="#7461E8" FontWeight="SemiBold" FontSize="12" Margin="15,0,0,0"/>
   <TextBlock Text="© 2026 渝水龙" Foreground="#A0A5B2" FontSize="10" Margin="15,7,0,0"/>
   <Button x:Name="About" Content="关于 BudsDesk" Background="Transparent" FontSize="12" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,4,0">
    <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="我的耳机" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="留一点安静，给自己。" Foreground="#9399A8" FontSize="12" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" CornerRadius="12" Padding="14,10"><TextBlock x:Name="Badge" Text="●  尚未连接" Foreground="#8E94A2" FontSize="12"/></Border></Grid>
    <Border Style="{StaticResource Card}" Padding="26,20" Margin="0,0,0,16">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Xiaomi Buds 5 Pro" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="蓝牙版  /  你的桌面耳机伴侣" Foreground="#9297A6" FontSize="12" Margin="0,10,0,18"/><Border Background="#F3F1FD" CornerRadius="9" Padding="10,6" HorizontalAlignment="Left"><TextBlock x:Name="HeroMode" Text="等待连接" Foreground="#7865DA" FontSize="12"/></Border><TextBlock Text="耳机外形为示意插画" Foreground="#B1B4BF" FontSize="10" Margin="0,20,0,0"/></StackPanel>
      <Viewbox Grid.Column="1" Width="224" Height="180">
       <Canvas Width="260" Height="210">
        <Canvas.Resources><LinearGradientBrush x:Key="Metal" StartPoint="0,0" EndPoint="1,0.8"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#D9DCE5" Offset="0.35"/><GradientStop Color="#FDFEFF" Offset="0.64"/><GradientStop Color="#AEB4C5" Offset="1"/></LinearGradientBrush></Canvas.Resources>
        <Ellipse Width="220" Height="160" Fill="#F1EFFC" Canvas.Left="20" Canvas.Top="25"/>
        <Ellipse Width="130" Height="15" Fill="#E2DEEF" Canvas.Left="65" Canvas.Top="185"/>
        <Canvas Canvas.Left="50" Canvas.Top="28"><Canvas.RenderTransform><RotateTransform Angle="-19" CenterX="40" CenterY="55"/></Canvas.RenderTransform><Border Width="30" Height="111" CornerRadius="15" Background="{StaticResource Metal}" Canvas.Left="38" Canvas.Top="52" BorderBrush="#C3C8D6" BorderThickness="1"/><Ellipse Width="77" Height="63" Fill="{StaticResource Metal}" Stroke="#D1D4DF" StrokeThickness="1"/><Ellipse Width="25" Height="31" Fill="#333847" Canvas.Left="-5" Canvas.Top="14"/><Ellipse Width="17" Height="23" Fill="#181D29" Canvas.Left="-2" Canvas.Top="18"/><Border Width="4" Height="14" CornerRadius="2" Background="#8E95A4" Canvas.Left="51" Canvas.Top="105"/></Canvas>
        <Canvas Canvas.Left="155" Canvas.Top="43"><Canvas.RenderTransform><RotateTransform Angle="22" CenterX="30" CenterY="55"/></Canvas.RenderTransform><Border Width="30" Height="111" CornerRadius="15" Background="{StaticResource Metal}" Canvas.Left="3" Canvas.Top="52" BorderBrush="#C3C8D6" BorderThickness="1"/><Ellipse Width="77" Height="63" Fill="{StaticResource Metal}" Stroke="#D1D4DF" StrokeThickness="1"/><Ellipse Width="25" Height="31" Fill="#333847" Canvas.Left="59" Canvas.Top="14"/><Ellipse Width="17" Height="23" Fill="#181D29" Canvas.Left="63" Canvas.Top="18"/><Border Width="4" Height="14" CornerRadius="2" Background="#8E95A4" Canvas.Left="16" Canvas.Top="105"/></Canvas>
       </Canvas>
      </Viewbox>
     </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Padding="20,17" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="连接耳机" FontWeight="SemiBold" FontSize="13"/><ComboBox x:Name="Devices" Margin="0,10,14,0" MinHeight="30" FontSize="12"/><TextBlock x:Name="Hint" Text="先在 Windows 蓝牙设置中配对并连接耳机。" Foreground="#969CAB" FontSize="11" Margin="0,8,10,0"/></StackPanel><Button x:Name="Scan" Grid.Column="1" Content="刷新" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="Connect" Grid.Column="2" Content="连接" Background="#7461E8" Foreground="White" VerticalAlignment="Center"/></Grid></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
     <StackPanel><DockPanel><TextBlock Text="聆听模式" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ModeState" Text="连接后可调节" Foreground="#959BAA" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <UniformGrid Columns="3" Margin="0,18,0,18">
       <Button x:Name="Anc" Margin="0,0,8,0" Padding="12,18" IsEnabled="False"><StackPanel><TextBlock Text="◉" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,9"/><TextBlock Text="降噪" HorizontalAlignment="Center"/><TextBlock Text="专注于此刻" FontSize="10" Opacity="0.65" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
       <Button x:Name="Off" Margin="4,0,4,0" Padding="12,18" IsEnabled="False"><StackPanel><TextBlock Text="○" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,9"/><TextBlock Text="关闭" HorizontalAlignment="Center"/><TextBlock Text="自然聆听" FontSize="10" Opacity="0.65" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
       <Button x:Name="Ambient" Margin="8,0,0,0" Padding="12,18" IsEnabled="False"><StackPanel><TextBlock Text="◎" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,9"/><TextBlock Text="通透" HorizontalAlignment="Center"/><TextBlock Text="听见周围" FontSize="10" Opacity="0.65" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
      </UniformGrid>
      <Border Background="#F7F7FB" CornerRadius="12" Padding="14,12"><DockPanel><CheckBox Content="自适应降噪" IsEnabled="False" VerticalAlignment="Center"/><TextBlock Text="适配中" FontSize="11" Foreground="#989EAC" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
     </StackPanel>
    </Border>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="20,17"><StackPanel><TextBlock Text="电量" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="L  —    R  —    盒  —" FontSize="17" Foreground="#A1A7B5" Margin="0,12,0,5"/><TextBlock Text="电量读取待适配" FontSize="10" Foreground="#9CA2AF"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,17"><StackPanel><TextBlock Text="随手控制" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="托盘菜单 · 全局快捷键" FontSize="12" Foreground="#777F91" Margin="0,12,0,5"/><TextBlock Text="关闭窗口后可在托盘继续使用" FontSize="10" Foreground="#9CA2AF"/></StackPanel></Border>
    </Grid>
    <TextBlock x:Name="Status" Text="准备就绪。" Foreground="#8D94A3" FontSize="11" Margin="4,0,4,12"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
